# Example rviz2 config for the curobo_task_constructor panel.
# Load the panel via: rviz2 -d share/curobo_task_constructor_rviz/rviz/task_constructor.rviz
# The panel + a MarkerArray display can be used side-by-side with any existing
# curobo/curobov2_ros marker publishers — these two only consume
# curobo_task_constructor_interfaces topics.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: curobo_task_constructor/Task Constructor
    Name: Task Constructor
    ExecuteOnServer: true
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.8
      Class: curobov2_ros_rviz/CuroboPlanningDisplay
      Collision Spheres Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo_server/collision_spheres
      Enabled: true
      Goal State Alpha: 0.5
      Gizmo Visible: false
      Loop Animation: false
      Name: CuroboPlanning
      Planner Node: curobo_server
      Place target at tool: true
      Show IK result: false
      Show Attached: true
      Show Trail: false
      Speed: 1
      Target Orientation W: 1
      Target Orientation X: 0
      Target Orientation Y: 0
      Target Orientation Z: 0
      Target Position X: 0.4
      Target Position Y: 0
      Target Position Z: 0.4
      Trail Step Size: 10
      Trajectory Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo_task_constructor/solution_trajectory
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Selected solution markers
      Topic:
        Value: /curobo_task_constructor/selected_solution_markers
      Value: true
  Global Options:
    Fixed Frame: world
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5