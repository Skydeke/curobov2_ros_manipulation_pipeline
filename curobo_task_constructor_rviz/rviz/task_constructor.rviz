# Example rviz2 config for the curobo_task_constructor panel.
# Load the panel via: rviz2 -d share/curobo_task_constructor_rviz/rviz/task_constructor.rviz
# The panel + a MarkerArray display can be used side-by-side with any existing
# curobo/isaac_ros_cumotion marker publishers — these two only consume
# curobo_task_constructor_interfaces topics.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: curobo_task_constructor/Task Constructor
    Name: Task Constructor
    ExecuteOnServer: true
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Selected solution markers
      Topic:
        Value: /curobo_task_constructor/selected_solution_markers
      Value: true
  Global Options:
    Fixed Frame: world
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5