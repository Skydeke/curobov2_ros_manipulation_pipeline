<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cutamp_ros</name>
  <version>0.1.0</version>
  <description>
    rclcpp component that runs cuTAMP inside the cuRobo process's embedded
    CPython interpreter and returns ordered curobov2_ros_interfaces/Goalset
    segments for the cuRobo trajectory planner.
  </description>
  <maintainer email="me@todo.com">me</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>pybind11_vendor</build_depend>
  <build_depend>python3-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>curobov2_ros_interfaces</depend>
  <depend>cutamp_ros_interfaces</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
