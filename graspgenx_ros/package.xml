<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graspgenx_ros</name>
  <version>0.1.0</version>
  <description>
    rclcpp component that serves grasp_pose_detection_interfaces/GenerateGrasps
    using GraspGenX inside the cuRobo process's embedded CPython interpreter.
  </description>
  <maintainer email="me@todo.com">me</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>pybind11_vendor</build_depend>
  <build_depend>python3-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>grasp_pose_detection_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-trimesh</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
