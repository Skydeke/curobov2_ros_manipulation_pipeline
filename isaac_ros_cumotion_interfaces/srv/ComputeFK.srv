# Compute forward kinematics for one or more joint configurations.
# Returns the 6-DOF pose of each queried tool frame for every input joint state.

sensor_msgs/JointState[] joint_states     # one or more joint configurations
string[] tool_frames                      # tool/end-effector frames to query; empty = all tool frames
---
bool success
string message
geometry_msgs/Pose[] tool_poses           # flattened: [config0_frame0, config0_frame1, ..., config1_frame0, ...]
string[] resolved_frame_names             # tool frame names in order (length = num_frames)
int32 num_configs                         # number of input joint configurations
int32 num_frames                          # number of tool frames per config
float32 solve_time_s
