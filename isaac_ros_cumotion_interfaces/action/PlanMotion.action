# Plan a collision-aware motion from a start state to a goal.
# Exactly one of goal_poses / goal_joint_state must be non-empty.

sensor_msgs/JointState start_state        # empty position array = use robot's current state
geometry_msgs/Pose[] goal_poses           # Cartesian goal(s) in the planning frame
sensor_msgs/JointState goal_joint_state   # joint-space goal; mutually exclusive with goal_poses
bool plan_goal_set                        # true: goal_poses is an unordered set, any one reachable goal is accepted
                                           # false: goal_poses must contain exactly one pose, which must be reached
string tool_frame                         # empty = planner's default tool/end-effector frame
bool enable_graph_search                  # true = allow graph-planner fallback if trajopt fails
float32 time_dilation_factor              # 1.0 = default velocity/accel scaling; 0 = use planner default
---
bool success
string message
moveit_msgs/MoveItErrorCodes error_code
trajectory_msgs/JointTrajectory trajectory
int32 matched_goal_index                  # index into goal_poses that was solved; -1 if goal_joint_state or on failure
float32 planning_time_s
---
string phase                              # "seeding" | "graph_search" | "trajopt" | "done"
