# Start and manage a model-predictive control loop.
# The server runs optimise_next_action() at the configured rate and
# publishes the commanded joint state on /cumotion/mpc/commanded_joint_state.
# Stops when StopMPC.srv is called or an error occurs.

sensor_msgs/JointState start_state
geometry_msgs/Pose[] goal_poses           # Cartesian goal(s) to track
string tool_frame                         # empty = planner's default tool/end-effector frame
float32 optimization_dt                   # seconds between MPC steps; 0 = solver default
int32 interpolation_steps                 # must be 4 for current MPCSolver; 0 = default
---
bool success
string message
int32 num_steps                           # number of MPC iterations executed
float32 total_control_time_s              # wall-clock duration of the control run
sensor_msgs/JointState final_state        # robot state at final step
---
string phase                              # "setup" | "running" | "stopping" | "done"
sensor_msgs/JointState current_action     # commanded joint state for current timestep
float32 solve_time_s                      # last optimise_next_action solve duration
float32 tracking_position_error           # current Cartesian position tracking error (meters)
float32 tracking_rotation_error           # current Cartesian rotation tracking error (radians)
