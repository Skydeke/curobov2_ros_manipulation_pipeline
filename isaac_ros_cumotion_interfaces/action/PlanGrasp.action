# Plan a collision-aware approach -> grasp -> lift motion. Wraps
# MotionPlanner.plan_grasp(). grasp_poses is a goal SET: the planner
# picks whichever candidate grasp pose is reachable.

sensor_msgs/JointState start_state        # empty = use robot's current state
geometry_msgs/Pose[] grasp_poses          # candidate grasp poses (goal set), in the planning frame
string tool_frame                         # empty = planner's default tool/end-effector frame
float32 grasp_approach_offset             # meters, pre-grasp offset along the approach axis
float32 grasp_lift_offset                 # meters, lift offset after grasping
bool plan_approach_to_grasp               # false = skip the approach segment
bool plan_grasp_to_lift                   # false = skip the lift segment
bool grasp_lift_in_tool_frame             # true = lift offset is along the tool's local axis, not world
---
bool success
string message
float32 planning_time_s
trajectory_msgs/JointTrajectory approach_trajectory   # empty if approach was skipped or not planned
trajectory_msgs/JointTrajectory grasp_trajectory
trajectory_msgs/JointTrajectory lift_trajectory       # empty if lift was skipped or not planned
int32 matched_goal_index                  # which grasp_poses entry was used, -1 on failure
---
string phase                              # "approach" | "grasp" | "lift" | "done"
