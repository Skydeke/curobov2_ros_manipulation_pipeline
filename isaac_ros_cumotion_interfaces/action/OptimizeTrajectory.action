# Direct trajectory optimization via TrajOptSolver (no graph-search fallback).
# Exactly one of goal_poses / goal_joint_state must be non-empty.

sensor_msgs/JointState start_state        # empty position array = use solver default state
geometry_msgs/Pose[] goal_poses           # Cartesian goal(s) in the planning frame
sensor_msgs/JointState goal_joint_state   # joint-space goal; mutually exclusive with goal_poses
string tool_frame                         # empty = planner's default tool/end-effector frame
int32 num_seeds                           # number of optimization seeds; <=0 = solver default
float32 position_tolerance                # meters; <=0 = solver default
float32 orientation_tolerance             # radians; <=0 = solver default
float32 trajectory_dt                     # seconds; <=0 = solver default
int32 finetune_attempts                   # additional refinement passes; <=0 = solver default
---
bool success
string message
trajectory_msgs/JointTrajectory trajectory
int32 matched_goal_index                  # index into goal_poses that was solved; -1 if goal_joint_state or on failure
float32 position_error                    # meters, max across trajectory
float32 rotation_error                    # radians, max across trajectory
float32 solve_time_s
bool feasible                             # constraint feasibility (independent of pose convergence)
---
string phase                              # "seeding" | "optimizing" | "finetuning" | "done"
