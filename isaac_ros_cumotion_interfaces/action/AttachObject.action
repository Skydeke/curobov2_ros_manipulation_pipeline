# Attach or detach an object to/from the robot's kinematic + collision model.
# When attach=true, exactly one of (sphere_centers/sphere_radii) or primitive must be given.
# When attach=false, only object_id is required.

bool attach
string object_id                         # caller-chosen unique id; reuse this id to detach later
string parent_link                       # link the object rigidly follows (e.g. gripper tool frame)
geometry_msgs/Pose pose_in_parent_link    # object pose relative to parent_link

geometry_msgs/Point[] sphere_centers      # option A: exact collision spheres, in parent_link frame
float32[] sphere_radii                    # same length as sphere_centers

shape_msgs/SolidPrimitive primitive       # option B: primitive shape, server auto-fits spheres. type=0 means "not provided"
float32 fallback_sphere_radius            # used only if auto-fit from `primitive` fails
---
bool success
string message
int32 num_spheres_attached
---
string status
