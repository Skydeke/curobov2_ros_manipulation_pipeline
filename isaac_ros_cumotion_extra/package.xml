<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaac_ros_cumotion_extra</name>
  <version>4.3.0</version>
  <description>Extra tools for isaac_ros_cumotion: ESDF/Viser visualizer and cuRobo config generator.</description>
  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>curobo_core</exec_depend>
  <exec_depend>iki_kortex_description</exec_depend>
  <exec_depend>iki_kortex_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  
  <depend>isaac_ros_cumotion_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
