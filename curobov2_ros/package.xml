<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>curobov2_ros</name>
  <version>1.0.0</version>
  <description>GPU-accelerated motion planning for ROS 2, powered by cuRobo (C++ server).</description>
  <maintainer email="me@todo.com">me</maintainer>
  <license>Apache-2.0</license>

  <!-- The package is the C++ server (UD-6 / Q5): runtime + core + component. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ build deps (folded from curobo_runtime / curobo_core / component). -->
  <build_depend>pybind11_vendor</build_depend>
  <build_depend>python3-dev</build_depend>
  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>curobov2_ros_interfaces</depend>

  <!-- Runtime / launch deps (kept from the Python package). -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ros2_numpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>curobo</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ros2_test_compose</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>rosidl_runtime_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
