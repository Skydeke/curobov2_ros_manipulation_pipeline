<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>curobo_runtime</name>
  <version>0.0.1</version>
  <description>Embedded-CPython runtime, GPU lanes, capture barrier and the pybind11 bridge seam for the curobov2_ros C++ port.</description>
  <maintainer email="me@todo.com">me</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- pybind11 is confined to this package (design rule 11.3). -->
  <build_depend>pybind11_vendor</build_depend>
  <build_depend>python3-dev</build_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
