<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>curobo_task_constructor_interfaces</name>
  <version>0.0.1</version>
  <description>
    Introspection and execution interfaces for the curobo_task_constructor,
    mirroring moveit_task_constructor_msgs: task description/statistics,
    solutions, and the ExecuteTaskSolution action. Planning is local
    (in-process, like MoveIt); only execution goes over the wire.
  </description>
  <maintainer email="me@todo.com">me</maintainer>
  <url type="repository">https://github.com/Skydeke/curobov2_ros_manipulation_pipeline</url>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
