ARG BASE_IMAGE=nvidia/cuda:13.2.0-devel-ubuntu24.04
FROM $BASE_IMAGE

ENV ROS_DISTRO=jazzy
ENV ROS_WS=/root/ros2_ws
ENV PIP_BREAK_SYSTEM_PACKAGES=1
SHELL ["/bin/bash", "-c"]

# Always-installed tooling (needed regardless of whether ROS is pre-installed)
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  curl \
  git \
  gnupg2 \
  meson \
  ninja-build \
  python-is-python3 \
  python3-dev \
  python3-pip \
  python3-venv \
  software-properties-common \
  && rm -rf /var/lib/apt/lists/* && \
  (command -v colcon >/dev/null 2>&1) || pip install colcon-common-extensions

# Install ROS 2 Jazzy + rosdep only if not already present in BASE_IMAGE.
# When BASE_IMAGE already has ROS (e.g. kortex:jazzy), skip to avoid
# Signed-By conflicts with the pre-installed ROS apt source.
RUN if [ ! -f /opt/ros/jazzy/setup.bash ]; then \
  apt-get update && apt-get install -y --no-install-recommends \
  curl gnupg2 ca-certificates && \
  curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
  -o /usr/share/keyrings/ros-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
  http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
  > /etc/apt/sources.list.d/ros2.list && \
  apt-get update && apt-get install -y --no-install-recommends \
  ros-jazzy-ros-base \
  python3-rosdep \
  ros-jazzy-rosidl-generator-type-description && \
  rm -rf /var/lib/apt/lists/* && \
  rosdep init 2>/dev/null || true && \
  rosdep update; \
  else \
  rosdep init 2>/dev/null || true && \
  rosdep update; \
  fi

# Core numerical stack
RUN python3 -m pip install --ignore-installed \
  "numpy<2" \
  "cuda-python<13" \
  "cuda-bindings~=12.9" \
  "cuda-core[cu12]" \
  "cupy-cuda12x<14" \
  "timm" \
  einops \
  hdbscan \
  "viser>=1" \
  torchvision

# Someone is misusing pinning, for no good damn reason
RUN git clone https://github.com/nitesh-subedi/ros2_numpy.git /tmp/ros2_numpy && \
  sed -i 's/numpy==1\.24\.2/numpy>=1.26.4,<2/' \
  /tmp/ros2_numpy/setup.py \
  /tmp/ros2_numpy/requirements.txt 2>/dev/null || true && \
  python3 -m pip install --ignore-installed /tmp/ros2_numpy

RUN apt-get update && apt-get install -y --reinstall \
  ros-jazzy-rosidl-generator-type-description \
  ros-jazzy-sensor-msgs \
  ros-jazzy-visualization-msgs \
  ros-jazzy-geometry-msgs \
  ros-jazzy-std-msgs \
  ros-jazzy-builtin-interfaces \
  ros-jazzy-trajectory-msgs \
  ros-jazzy-nav2-msgs \
  ros-jazzy-moveit-msgs && \
  rm -rf /var/lib/apt/lists/*

# --- isaac_ros_cumotion packages ---
COPY isaac_ros_cumotion ${ROS_WS}/src/isaac_ros_cumotion
COPY isaac_ros_cumotion_interfaces ${ROS_WS}/src/isaac_ros_cumotion_interfaces
COPY isaac_ros_cumotion_moveit ${ROS_WS}/src/isaac_ros_cumotion_moveit
COPY isaac_ros_cumotion_rviz ${ROS_WS}/src/isaac_ros_cumotion_rviz
COPY isaac_ros_cumotion_extra ${ROS_WS}/src/isaac_ros_cumotion_extra

# --- cuRobo v2 ---
COPY curobo_core ${ROS_WS}/src/curobo_core

WORKDIR ${ROS_WS}
# curobo_core/curobo is a nested git repo (gitfile pointing into the outer
# workspace's .git/modules), so its .git metadata is not present in this build
# context and setuptools-scm can't derive a version. Pin the version it would
# otherwise compute from the vendored repo's v0.8.0 tag.
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_NVIDIA_CUROBO=0.8.0 \
  pip install -e "${ROS_WS}/src/curobo_core/curobo[benchmark]"

RUN source /opt/ros/jazzy/setup.bash && \
  apt-get update && \
  rosdep install --from-paths ${ROS_WS}/src --ignore-src -r -y && \
  rm -rf /var/lib/apt/lists/*

# Rosdep fucks up warp-lang version
RUN pip install --upgrade "warp-lang>=1.10.0,<1.15.0"
RUN pip install "setuptools<70"

RUN source /opt/ros/jazzy/setup.bash && \
  colcon build --symlink-install \
  --packages-select \
  curobo_core isaac_ros_cumotion_interfaces \
  isaac_ros_cumotion isaac_ros_cumotion_moveit \
  isaac_ros_cumotion_rviz \
  isaac_ros_cumotion_extra
