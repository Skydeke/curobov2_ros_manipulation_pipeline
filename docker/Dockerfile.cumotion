ARG BASE_IMAGE=nvidia/cuda:13.2.0-devel-ubuntu24.04
FROM $BASE_IMAGE

ENV ROS_DISTRO=jazzy
ENV ROS_WS=/root/ros2_ws
ENV PIP_BREAK_SYSTEM_PACKAGES=1
SHELL ["/bin/bash", "-c"]

# Always-installed tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  curl \
  git \
  gnupg2 \
  meson \
  ninja-build \
  python-is-python3 \
  python3-dev \
  python3-pip \
  python3-venv \
  software-properties-common \
  && rm -rf /var/lib/apt/lists/* && \
  (command -v colcon >/dev/null 2>&1) || pip install colcon-common-extensions

# Install ROS 2 Jazzy + rosdep only if not already present in BASE_IMAGE.
# When BASE_IMAGE already has ROS
RUN if [ ! -f /opt/ros/jazzy/setup.bash ]; then \
  apt-get update && apt-get install -y --no-install-recommends \
  curl gnupg2 ca-certificates && \
  curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
  -o /usr/share/keyrings/ros-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
  http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
  > /etc/apt/sources.list.d/ros2.list && \
  apt-get update && apt-get install -y --no-install-recommends \
  ros-jazzy-ros-base \
  python3-rosdep \
  ros-jazzy-rosidl-generator-type-description && \
  rm -rf /var/lib/apt/lists/* && \
  rosdep init 2>/dev/null || true && \
  rosdep update; \
  else \
  rosdep init 2>/dev/null || true && \
  rosdep update; \
  fi

# Core numerical stack
RUN python3 -m pip install --ignore-installed \
  "numpy<2" \
  "cuda-python<13" \
  "cuda-bindings~=12.9" \
  "cuda-core[cu12]" \
  "cupy-cuda12x<14" \
  "timm" \
  einops \
  hdbscan \
  "viser>=1" \
  torchvision

# Someone is misusing pinning, for no good damn reason
RUN git clone https://github.com/nitesh-subedi/ros2_numpy.git /tmp/ros2_numpy && \
  sed -i 's/numpy==1\.24\.2/numpy>=1.26.4,<2/' \
  /tmp/ros2_numpy/setup.py \
  /tmp/ros2_numpy/requirements.txt 2>/dev/null || true && \
  python3 -m pip install --ignore-installed /tmp/ros2_numpy

RUN apt-get update && apt-get install -y --reinstall \
  ros-jazzy-rosidl-generator-type-description \
  ros-jazzy-sensor-msgs \
  ros-jazzy-visualization-msgs \
  ros-jazzy-geometry-msgs \
  ros-jazzy-std-msgs \
  ros-jazzy-builtin-interfaces \
  ros-jazzy-trajectory-msgs \
  ros-jazzy-nav2-msgs \
  ros-jazzy-moveit-msgs && \
  rm -rf /var/lib/apt/lists/*

# --- cuRobo v2: dependencies FIRST, sources LAST ---
COPY curobo/requirements.txt /tmp/curobo_requirements.txt
RUN pip install --no-cache-dir -r /tmp/curobo_requirements.txt

# --- isaac_ros_cumotion packages ---
COPY isaac_ros_cumotion ${ROS_WS}/src/isaac_ros_cumotion
COPY isaac_ros_cumotion_interfaces ${ROS_WS}/src/isaac_ros_cumotion_interfaces
COPY isaac_ros_cumotion_moveit ${ROS_WS}/src/isaac_ros_cumotion_moveit
COPY isaac_ros_cumotion_rviz ${ROS_WS}/src/isaac_ros_cumotion_rviz
COPY isaac_ros_cumotion_extra ${ROS_WS}/src/isaac_ros_cumotion_extra

# --- task-constructor packages
COPY curobo_task_constructor_interfaces ${ROS_WS}/src/curobo_task_constructor_interfaces
COPY curobo_task_constructor ${ROS_WS}/src/curobo_task_constructor
COPY curobo_task_constructor_rviz ${ROS_WS}/src/curobo_task_constructor_rviz

# --- cuRobo v2 ---
COPY curobo ${ROS_WS}/src/curobo

WORKDIR ${ROS_WS}

RUN source /opt/ros/jazzy/setup.bash && \
  apt-get update && \
  rosdep install --from-paths ${ROS_WS}/src --ignore-src -r -y && \
  rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/jazzy/setup.bash && \
  colcon build --symlink-install \
  --packages-select \
  curobo isaac_ros_cumotion_interfaces \
  isaac_ros_cumotion isaac_ros_cumotion_moveit \
  isaac_ros_cumotion_rviz isaac_ros_cumotion_extra \
  curobo_task_constructor_interfaces \
  curobo_task_constructor curobo_task_constructor_rviz
